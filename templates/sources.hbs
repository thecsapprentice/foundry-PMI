<div class="pmi-sources-body">
  <p class="hint">{{hint}}</p>
  <ul class="pmi-pack-list">
    {{#each packs}}
    <li>
      <label>
        <input type="checkbox" name="pack" value="{{id}}" {{#if checked}}checked{{/if}}>
        <span class="pmi-pack-label">{{label}}</span>
        <span class="pmi-pack-meta">{{source}} · {{count}}</span>
      </label>
    </li>
    {{else}}
    <li class="hint">{{none}}</li>
    {{/each}}
  </ul>
  <footer class="form-footer">
    <button type="submit"><i class="fa-solid fa-floppy-disk"></i> {{localize "PMI.Settings.Save"}}</button>
  </footer>
</div>
