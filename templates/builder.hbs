<div class="pmi-layout rarity-{{recipe.rarity}}">
  <section class="pmi-main">
    <div class="pmi-block">
      <h3 class="pmi-heading">{{localize "PMI.Builder.Base"}}</h3>
      <div class="pmi-kinds" role="group" aria-label="{{localize "PMI.Builder.RandomBase"}}">
        {{#each baseKinds}}
        <button type="button" class="pmi-kind {{#if active}}active{{/if}}" data-action="randomBase" data-kind="{{kind}}"
                aria-label="{{tooltip}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}" {{#if disabled}}disabled{{/if}}>
          <i class="{{icon}}" aria-hidden="true"></i>
          <span>{{label}}</span>
        </button>
        {{/each}}
      </div>
      <div class="pmi-base-row">
        {{#if baseImg}}<img class="pmi-base-img" src="{{baseImg}}" alt="">{{/if}}
        <select name="base" aria-label="{{localize "PMI.Builder.Base"}}">
          <option value="">{{localize "PMI.Builder.ChooseBaseOption"}}</option>
          {{#each bases}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}} ({{group}})</option>{{/each}}
        </select>
      </div>
      {{#if noBases}}<p class="pmi-warn"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "PMI.Builder.NoBases"}}</p>
      {{else}}<p class="pmi-hint">{{localize "PMI.Builder.DropHint"}}</p>{{/if}}
    </div>

    <div class="pmi-block">
      <h3 class="pmi-heading">{{localize "PMI.Builder.Rarity"}}</h3>
      <div class="pmi-rarities" role="radiogroup" aria-label="{{localize "PMI.Builder.Rarity"}}">
        {{#each rarities}}
        <button type="button" class="pmi-rarity rarity-{{key}} {{#if selected}}active{{/if}}" role="radio"
                aria-checked="{{#if selected}}true{{else}}false{{/if}}" data-action="setRarity" data-rarity="{{key}}">{{label}}</button>
        {{/each}}
        <button type="button" class="pmi-rarity pmi-rarity-random" data-action="randomRarity" data-tooltip="PMI.Builder.RandomRarity"
                aria-label="{{localize "PMI.Builder.RandomRarity"}}"><i class="fa-solid fa-dice" aria-hidden="true"></i></button>
      </div>
    </div>

    <div class="pmi-block">
      <div class="pmi-budget {{#if tally.over}}over{{/if}}">
        <h3 class="pmi-heading">{{localize "PMI.Builder.Properties"}}</h3>
        <span class="pmi-budget-text">{{localize "PMI.Builder.BudgetUsed"}} {{tally.spent}}/{{tally.budget}}{{#if tally.refund}} ({{localize "PMI.Builder.Refund"}} +{{tally.refund}}){{/if}}, {{tally.count}}/{{tally.maxProperties}} {{localize "PMI.Builder.PropertiesWord"}}</span>
        <div class="pmi-meter" role="meter" aria-valuemin="0" aria-valuemax="{{tally.budget}}" aria-valuenow="{{tally.spent}}"
             aria-label="{{localize "PMI.Builder.Budget"}}"><div style="width: {{tally.percent}}%"></div></div>
      </div>
      {{#if tally.over}}<p class="pmi-warn"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "PMI.Builder.OverBudget"}}</p>{{/if}}

      <div class="pmi-cards">
        {{#each picks}}
        <article class="pmi-card slot-{{slotKey}} {{#if curse}}curse{{/if}} {{#if locked}}locked{{/if}} {{#if problem}}problem{{/if}}">
          <header class="pmi-card-head">
            <span class="pmi-card-slot">{{#if curse}}<i class="fa-solid fa-skull" aria-hidden="true"></i> {{/if}}{{slot}}</span>
            <span class="pmi-card-cost" data-tooltip="PMI.Builder.Cost">{{cost}}</span>
          </header>
          <h4 class="pmi-card-name">{{#if locked}}<i class="fa-solid fa-lock" aria-label="{{localize "PMI.Builder.Locked"}}"></i> {{/if}}{{label}}</h4>
          {{#if params}}<p class="pmi-card-params">{{params}}</p>{{/if}}
          {{#if problem}}<p class="pmi-card-problem"><i class="fa-solid fa-triangle-exclamation"></i> {{problem}}</p>{{/if}}
          <footer class="pmi-card-controls">
            <button type="button" data-action="lock" data-index="{{index}}" data-tooltip="{{#if locked}}PMI.Builder.Unlock{{else}}PMI.Builder.Lock{{/if}}"
                    aria-label="{{#if locked}}{{localize "PMI.Builder.Unlock"}}{{else}}{{localize "PMI.Builder.Lock"}}{{/if}}" aria-pressed="{{#if locked}}true{{else}}false{{/if}}">
              <i class="fa-solid {{#if locked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button>
            <button type="button" data-action="reroll" data-index="{{index}}" data-tooltip="PMI.Builder.Reroll" aria-label="{{localize "PMI.Builder.Reroll"}}">
              <i class="fa-solid fa-rotate"></i></button>
            <button type="button" data-action="rerollParams" data-index="{{index}}" data-tooltip="PMI.Builder.RerollParams"
                    aria-label="{{localize "PMI.Builder.RerollParams"}}" {{#unless hasParams}}disabled{{/unless}}>
              <i class="fa-solid fa-dice-d6"></i></button>
            <button type="button" data-action="remove" data-index="{{index}}" data-tooltip="PMI.Builder.Remove" aria-label="{{localize "PMI.Builder.Remove"}}">
              <i class="fa-solid fa-xmark"></i></button>
          </footer>
        </article>
        {{/each}}

        <div class="pmi-card pmi-card-add">
          {{#if addable.length}}
          <label class="pmi-card-slot" for="pmi-add-property">{{localize "PMI.Builder.AddProperty"}}</label>
          <select id="pmi-add-property" name="addProperty">
            <option value="">{{localize "PMI.Builder.ChooseProperty"}}</option>
            {{#each addable}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}{{#if over}} ⚠{{/if}}</option>{{/each}}
          </select>
          <div class="pmi-add-buttons">
            <button type="button" data-action="add"><i class="fa-solid fa-plus"></i> {{localize "PMI.Builder.Add"}}</button>
            <button type="button" data-action="addCurse" data-tooltip="PMI.Builder.AddCurseHint" {{#unless canCurse}}disabled{{/unless}}>
              <i class="fa-solid fa-skull"></i> {{localize "PMI.Builder.AddCurse"}}</button>
          </div>
          {{else}}
          <p class="pmi-hint">{{#if baseName}}{{localize "PMI.Builder.NothingToAdd"}}{{else}}{{localize "PMI.Builder.ChooseBase"}}{{/if}}</p>
          {{/if}}
        </div>
      </div>
      {{#unless picks.length}}<p class="pmi-hint">{{localize "PMI.Builder.NoPicks"}}</p>{{/unless}}
    </div>
  </section>

  <aside class="pmi-side">
    <div class="pmi-preview">
      {{#if preview}}
      <header class="pmi-preview-head">
        <img src="{{preview.img}}" alt="">
        <div class="pmi-preview-title">
          {{#if editingName}}
          <input type="text" name="customName" class="pmi-name-input" value="{{preview.name}}" maxlength="80"
                 aria-label="{{localize "PMI.Builder.EditName"}}">
          {{else}}
          <h3 class="pmi-item-name">{{preview.name}}</h3>
          {{/if}}
          <p class="pmi-item-sub">{{preview.rarityLabel}}{{#if preview.attunement}}, {{localize "PMI.Builder.RequiresAttunement"}}{{/if}}</p>
          <p class="pmi-item-unid" data-tooltip="PMI.Builder.UnidentifiedHint"><i class="fa-solid fa-eye-slash" aria-hidden="true"></i> {{preview.unidentifiedName}}</p>
        </div>
        <div class="pmi-name-tools" role="group" aria-label="{{localize "PMI.Builder.NameTools"}}">
          <button type="button" data-action="rerollName" data-tooltip="PMI.Builder.RerollName" aria-label="{{localize "PMI.Builder.RerollName"}}">
            <i class="fa-solid fa-dice"></i></button>
          <button type="button" data-action="toggleName" data-tooltip="{{preview.toggleTooltip}}" aria-label="{{preview.toggleTooltip}}"
                  aria-pressed="{{#if preview.usesTrueName}}true{{else}}false{{/if}}" {{#unless preview.canToggle}}disabled{{/unless}}>
            <i class="fa-solid fa-tag"></i></button>
          <button type="button" data-action="editName" data-tooltip="PMI.Builder.EditName" aria-label="{{localize "PMI.Builder.EditName"}}">
            <i class="fa-solid fa-pen"></i></button>
        </div>
      </header>
      <div class="pmi-description">{{{preview.description}}}</div>
      {{else}}
      <div class="pmi-preview-empty">
        <i class="fa-solid fa-wand-sparkles" aria-hidden="true"></i>
        <p>{{#if baseName}}{{localize "PMI.Builder.PreviewEmpty"}}{{else}}{{localize "PMI.Builder.ChooseBase"}}{{/if}}</p>
      </div>
      {{/if}}
      {{#each errors}}<p class="pmi-error"><i class="fa-solid fa-circle-xmark"></i> {{this}}</p>{{/each}}
      {{#each warnings}}<p class="pmi-warn"><i class="fa-solid fa-triangle-exclamation"></i> {{this}}</p>{{/each}}
    </div>
    <div class="pmi-actions">
      <button type="button" data-action="roll" class="pmi-roll" {{#unless baseName}}disabled{{/unless}}>
        <i class="fa-solid fa-dice-d20"></i> {{localize "PMI.Builder.Roll"}}</button>
      <button type="button" data-action="toggleIdentified" class="pmi-identify {{#unless identified}}unidentified{{/unless}}"
              aria-pressed="{{#if identified}}false{{else}}true{{/if}}"
              data-tooltip="{{#if identified}}PMI.Builder.MakeUnidentified{{else}}PMI.Builder.MakeIdentified{{/if}}">
        <i class="fa-solid {{#if identified}}fa-eye{{else}}fa-eye-slash{{/if}}"></i>
        {{#if identified}}{{localize "PMI.Builder.Identified"}}{{else}}{{localize "PMI.Builder.Unidentified"}}{{/if}}</button>
      <button type="button" data-action="create" class="pmi-create" {{#unless canCreate}}disabled{{/unless}}>
        <i class="fa-solid {{#if busy}}fa-spinner fa-spin{{else}}fa-hammer{{/if}}"></i> {{localize "PMI.Builder.Create"}}</button>
      <p class="pmi-hint">{{localize "PMI.Builder.CreateHint"}}</p>
      <p class="pmi-seed">{{localize "PMI.Builder.Seed"}} {{recipe.seed}}</p>
    </div>
  </aside>
</div>
